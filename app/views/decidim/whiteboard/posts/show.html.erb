<% provide(:title, translated_attribute(post.title)) %>

<% add_decidim_meta_tags({
                           title: translated_attribute(post.title),
                           description: translated_attribute(post.body),
                           url: post_url(post.id)
                         }) %>

<%
  edit_link(
    resource_locator(post).edit,
    :update,
    :blogpost,
    blogpost: post
  )
%>

<%= append_javascript_pack_tag "decidim_whiteboard" %>
<%= append_stylesheet_pack_tag "decidim_whiteboard" %>

  <main class="flex justify-center">
    <%= announcement = render(partial: "decidim/shared/component_announcement") %>
  
    <%= append_stylesheet_pack_tag "decidim_iframe" %>
  
    <div style="width: 100%">
    <section class="iframe layout-main__section">
        <iframe
          id="whiteboard-spacedeck-frame"
          src="<%= @iframe_src %>"
          style="width: 100%"
          height="<%= @iframe_height %>"
          frameborder="0"
          allowfullscreen>
        </iframe>
    </section>
  </main>
  </div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const iframe = document.getElementById("whiteboard-spacedeck-frame");
    if (!iframe) return;

    const currentDecidimUserId = "<%= current_user&.id || "" %>";
    const isLoggedIn = !!currentDecidimUserId;
    const LAST_USER_KEY = "whiteboard:last_user_id";
    const TOKEN_MESSAGE_TYPES = [
      "spacedeck-token",
      "spacedeck-embedded-auth",
      "decidim:whiteboard:setToken",
      "spacedeck-force-logout"
    ];
    const TOKEN_KEYS = ["accessToken", "access_token", "token", "nextToken"];
    const ALLOWED_PARENTS = [
      window.location.origin,
      "https://dashboard-dev.urbreath.tech",
      "https://decidim-dev.urbreath.tech",
      "https://decidim-2-dev.urbreath.tech",
      "http://localhost:3001",
      "http://localhost:3001/testIframe.html",
      "https://community_demo.road-steamer.eu"
    ];

    let lastSentSignature = null;
    let lastTokenSeen = null;
    let forceLogoutOnLoad = !isLoggedIn;
    let hasForcedLogout = false;
    let hasRemoteLogout = false;
    let inMemoryBundle = null;

    function markUserChange() {
      try {
        const prev = window.localStorage ? window.localStorage.getItem(LAST_USER_KEY) : null;
        if (prev !== currentDecidimUserId) {
          if (window.localStorage) {
            window.localStorage.setItem(LAST_USER_KEY, currentDecidimUserId || "");
          }
          // user changed or logged out
          forceLogoutOnLoad = !!prev || !isLoggedIn;
          if (forceLogoutOnLoad) {
            clearStoredBundle();
          }
        }
      } catch (err) {
        if (!isLoggedIn) {
          forceLogoutOnLoad = true;
          clearStoredBundle();
        }
      }
    }

    function bundleSignature(bundle) {
      if (!bundle || !bundle.token) return null;
      const userId = bundle.userId || "";
      const email = bundle.email || "";
      const name = bundle.name || "";
      return [bundle.token, userId, email, name].join("|");
    }

    function storeAuthBundle(bundle) {
      // Keep auth only in-memory for this page view; do not persist between visits
      inMemoryBundle = bundle && bundle.token ? { ...bundle } : null;
    }

    function clearStoredBundle() {
      inMemoryBundle = null;
      lastSentSignature = null;
      lastTokenSeen = null;
      try {
        if (window.sessionStorage) {
          window.sessionStorage.removeItem("sd_session_token");
        }
        if (window.localStorage) {
          window.localStorage.removeItem("sd_session_token");
          window.localStorage.removeItem("sd_session_email");
          window.localStorage.removeItem("sd_session_name");
          window.localStorage.removeItem("sd_session_user_id");
        }
      } catch (err) {}
    }

    function loadStoredBundle() {
      return inMemoryBundle;
    }

    function resolveIframeOrigin() {
      try {
        return new URL(iframe.src).origin;
      } catch (err) {
        try {
          return iframe.src ? new URL(iframe.src, window.location.href).origin : null;
        } catch (secondErr) {
          return null;
        }
      }
    }

    function originAllowed(origin) {
      if (!origin) return false;
      const iframeOrigin = resolveIframeOrigin();
      if (iframeOrigin && origin === iframeOrigin) return true;
      return ALLOWED_PARENTS.indexOf(origin) !== -1;
    }

    function remoteLogout() {
      if (hasRemoteLogout) return;
      const origin = resolveIframeOrigin();
      if (!origin) return;
      hasRemoteLogout = true;
      try {
        fetch(origin + "/api/sessions/current", {
          method: "DELETE",
          credentials: "include",
          mode: "cors"
        }).catch(() => {});
      } catch (err) {}
    }

    function pickToken(data) {
      for (const key of TOKEN_KEYS) {
        if (data && typeof data === "object" && data[key]) {
          return data[key];
        }
      }
      return null;
    }

    function forwardTokenToSpacedeck(bundle, reason) {
      if (!iframe || !iframe.contentWindow) return;
      if (!bundle) return;
      const isForceLogout = bundle.type === "spacedeck-force-logout";
      if (!bundle.token && !isForceLogout) return;

      const signature = isForceLogout && !bundle.token ? null : bundleSignature(bundle);
      if (signature) {
        if (signature === lastSentSignature && !reason) return;
        lastSentSignature = signature;
      }

      iframe.contentWindow.postMessage(
        {
          embedded: true,
          accessToken: bundle.token,
          email: bundle.email || undefined,
          name: bundle.name || undefined,
          type: bundle.type
        },
        "*"
      );
    }

    function sendForceLogout(reason) {
      forwardTokenToSpacedeck({ type: "spacedeck-force-logout" }, reason || "force-logout");
    }

    function sendCachedBundle(reason) {
      const cached = loadStoredBundle();
      if (cached && cached.token && isLoggedIn) {
        forwardTokenToSpacedeck(cached, reason);
      }
    }

    markUserChange();
    // ensure no persisted tokens survive across visits
    clearStoredBundle();

    window.addEventListener("message", function handleAuthMessage(event) {
      if (!originAllowed(event.origin)) return;

      const data = event.data;
      if (!data || typeof data !== "object") return;

      // se il messaggio arriva da Decidim senza token, trattalo come logout esplicito
      if (!data.accessToken && !data.token && data.parentOrigin === window.location.origin) {
        clearStoredBundle();
        forceLogoutOnLoad = true;
        hasForcedLogout = false;
        sendForceLogout("decidim-logout-message");
        remoteLogout();
        return;
      }

      const isExpectedType =
        data.embedded === true ||
        (data.type && TOKEN_MESSAGE_TYPES.includes(data.type));

      if (!isExpectedType) return;

      // Accettiamo token solo se arrivano dal parent (es. dashboard Decidim) e non dall'iframe Spacedeck stesso
      const iframeOrigin = resolveIframeOrigin();
      const isFromIframe = iframeOrigin && event.origin === iframeOrigin;
      const hasParentOrigin = typeof data.parentOrigin === "string" && data.parentOrigin.length > 0;
      if (!hasParentOrigin || isFromIframe) {
        return;
      }

      // se nessun utente decidim è loggato, rifiutiamo qualsiasi token e forziamo logout
      if (!isLoggedIn && data.type !== "spacedeck-force-logout") {
        clearStoredBundle();
        sendForceLogout("not-logged-in");
        remoteLogout();
        return;
      }

      const token = pickToken(data);
      if (!token && data.type !== "spacedeck-force-logout") return;

      const email =
        data.email ||
        (data.user && data.user.email) ||
        data.username ||
        data.userEmail ||
        null;

      const name =
        data.name ||
        (data.user && (data.user.name || data.user.displayName)) ||
        data.fullName ||
        data.preferred_username ||
        (email ? email.split("@")[0] : null);

      const userId = data.userId || data.user_id || null;
      const bundle = { token, email, name, userId, type: data.type };

      storeAuthBundle(bundle);
      forwardTokenToSpacedeck(bundle, "message");

      if (token && token !== lastTokenSeen) {
        lastTokenSeen = token;
        sendCachedBundle("token-refresh");
      }
    });

    iframe.addEventListener("load", function () {
      if (forceLogoutOnLoad && !hasForcedLogout) {
        sendForceLogout("user-changed");
        remoteLogout();
        hasForcedLogout = true;
        forceLogoutOnLoad = false;
        return;
      }
      if (!isLoggedIn) return;
      sendCachedBundle("iframe-load");
    });

    // se la pagina nasce senza utente loggato, prova a disattivare la sessione spacedeck fin da subito
    if (!isLoggedIn) {
      clearStoredBundle();
      sendForceLogout("initial-guest");
      remoteLogout();
    }
  });
</script>

<%= render layout: "layouts/decidim/shared/layout_center", locals: { columns: 8 } do %>

  <section class="layout-main__section layout-main__heading">
    <div class="flex justify-center">
      <h1 class="title-decorator my-12"><%= translated_attribute post.title %></h1>
    </div>

    <% if post.photo.present? %>
      <div class="blog__image grow">
        <%= image_tag post.photo.big_url, alt: post.photo.description || post.photo.title || t("alt", scope: "decidim.application.photo") %>
      </div>
    <% end %>

    <div class="layout-author">
      <%= cell "decidim/author", post_presenter.author, from: post, context_actions: [:date], layout: :compact %>
    </div>
  </section>

  <section class="layout-main__section">
    <div class="editor-content">
      <%= decidim_sanitize_editor_admin translated_attribute post.body %>
    </div>

    <%= attachments_for post %>

    <%= render partial: "actions" %>
  </section>

  <section class="layout-main__section">
    <%= comments_for post %>
  </section>
<% end %>
