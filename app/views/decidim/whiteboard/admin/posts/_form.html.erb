<div class="form__wrapper">
  <div class="card pt-4">
    <div class="card-section">

      <div class="row column">
        <%= post_author_select_field form, :decidim_author_id, label: t("decidim.whiteboard.actions.author_id") %>
      </div>

      <div class="row column">
        <%= form.translated :text_field, :title, autofocus: true, aria: { label: :title } %>
      </div>

      <div class="row column">
        <%= form.translated :editor, :body, lines: 30, aria: { label: :body } %>
      </div>

      <div class="row">
        <div class="columns">
          <%= form.datetime_field :published_at %>
        </div>
      </div>

      <!-- URL + pulsante modal -->
      <div class="row align-middle">
        <div class="columns small-8">
          <%= form.text_field :iframe_src, id: "iframe_src_field", label: "URL" %>
        </div>
        <div class="columns small-4 text-right">
          <button type="button" id="openIframeModal" class="button button__sm button__secondary">
            Select board 
          </button>
        </div>
      </div>

      <div class="row">
        <div class="columns">
          <%= form.text_field :iframe_width, label: t("decidim.whiteboard.admin.posts.form.iframe_width"), value: form.object.iframe_width || "100%" %>
        </div>
      </div>

      <div class="row">
        <div class="columns">
          <%= form.number_field :iframe_height, label: t("decidim.whiteboard.admin.posts.form.iframe_height"), value: form.object.iframe_height || 800 %>
        </div>
      </div>

      <!-- Modal personalizzato -->
      <div id="iframeModal" class="custom-modal" style="display: none;">
        <div class="custom-modal-content">
          <span id="closeIframeModal" class="custom-modal-close">&times;</span>
          <div class="iframe-preview-wrapper">
            <iframe id="iframePreview"
                    src=""
                    allowfullscreen>
            </iframe>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Script -->
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const modal = document.getElementById("iframeModal");
    const openBtn = document.getElementById("openIframeModal");
    const closeBtn = document.getElementById("closeIframeModal");
    const iframe = document.getElementById("iframePreview");
    const input = document.getElementById("iframe_src_field");
    const DEFAULT_IFRAME_URL = "https://spacedeck-dev.urbreath.tech/spaces";
    const TOKEN_MESSAGE_TYPES = [
      "spacedeck-token",
      "spacedeck-embedded-auth",
      "decidim:whiteboard:setToken",
      "spacedeck-force-logout"
    ];
    const TOKEN_KEYS = ["accessToken", "access_token", "token", "nextToken"];
    const STORAGE_KEYS = {
      token: "sd_session_token",
      email: "sd_session_email",
      name: "sd_session_name",
      userId: "sd_session_user_id"
    };
    const ALLOWED_PARENTS = [
      window.location.origin,
      "https://dashboard-dev.urbreath.tech",
      "https://decidim-dev.urbreath.tech",
      "https://decidim-2-dev.urbreath.tech",
      "http://localhost:3001",
      "http://localhost:3001/testIframe.html",
      "https://community_demo.road-steamer.eu"
    ];
    let lastSentSignature = null;
    let lastForcedLogoutToken = null;

    if (!modal || !openBtn || !iframe) {
      console.warn("[Whiteboard] Missing core modal elements, skipping iframe modal init");
      return;
    }

    function currentIframeUrl() {
      if (input && typeof input.value === "string") {
        const trimmed = input.value.trim();
        if (trimmed) return trimmed;
      }
      return DEFAULT_IFRAME_URL;
    }

    function normalizeSpacesUrl(rawUrl) {
      try {
        const url = new URL(rawUrl, window.location.href);
        if (!url.pathname || url.pathname === "/") {
          url.pathname = "/spaces";
        }
        return url.toString();
      } catch (err) {
        return rawUrl;
      }
    }

    function forceLogoutSpacedeck() {
      if (!iframe || !iframe.contentWindow) return;
      const cached = loadStoredBundle();
      if (!cached || !cached.token) return; // evita logout a vuoto al primo open

      if (lastForcedLogoutToken === cached.token) return;

      const payload = {
        type: "spacedeck-force-logout",
        nextToken: cached.token,
        email: cached.email || undefined,
        name: cached.name || undefined
      };
      try {
        iframe.contentWindow.postMessage(payload, "*");
        lastForcedLogoutToken = cached.token;
      } catch (err) {
        console.warn("[Whiteboard] Unable to force logout Spacedeck iframe", err);
      }
    }

    function openModal() {
      const iframeUrl = normalizeSpacesUrl(currentIframeUrl());
      iframe.src = iframeUrl;
      modal.style.display = "flex";
    }

    function closeModal() {
      modal.style.display = "none";
      // non resettiamo src per evitare flicker/loop di logout
    }

    openBtn.addEventListener("click", function () {
      openModal();
      setTimeout(function () {
        try {
          sendCachedBundle("modal-open");
        } catch (err) {
          console.warn("[Whiteboard] Unable to send cached bundle on modal open", err);
        }
      }, 0);
    });
    if (closeBtn) {
      closeBtn.addEventListener("click", closeModal);
    }

    window.addEventListener("click", function(event) {
      if (event.target === modal) {
        closeModal();
      }
    });

    function originAllowed(origin) {
      return ALLOWED_PARENTS.indexOf(origin) !== -1;
    }

    function pickToken(data) {
      for (const key of TOKEN_KEYS) {
        if (data && typeof data === "object" && data[key]) {
          return data[key];
        }
      }
      return null;
    }

    function storeAuthBundle(bundle) {
      if (!bundle || !bundle.token) return;
      try {
        if (bundle.userId && window.localStorage) {
          window.localStorage.setItem(STORAGE_KEYS.userId, String(bundle.userId));
        }
        if (bundle.token && window.sessionStorage) {
          window.sessionStorage.setItem(STORAGE_KEYS.token, bundle.token);
        }
        if (bundle.token && window.localStorage) {
          window.localStorage.setItem(STORAGE_KEYS.token, bundle.token);
        }
        if (bundle.email && window.localStorage) {
          window.localStorage.setItem(STORAGE_KEYS.email, bundle.email);
        }
        if (bundle.name && window.localStorage) {
          window.localStorage.setItem(STORAGE_KEYS.name, bundle.name);
        }
      } catch (err) {
        console.warn("[Whiteboard] Unable to persist auth bundle", err);
      }
    }

    function loadStoredBundle() {
      try {
        const token =
          (window.sessionStorage && window.sessionStorage.getItem(STORAGE_KEYS.token)) ||
          (window.localStorage && window.localStorage.getItem(STORAGE_KEYS.token));
        const email = window.localStorage ? window.localStorage.getItem(STORAGE_KEYS.email) : null;
        const name = window.localStorage ? window.localStorage.getItem(STORAGE_KEYS.name) : null;
        const userId = window.localStorage ? window.localStorage.getItem(STORAGE_KEYS.userId) : null;
        return { token, email, name, userId };
      } catch (err) {
        console.warn("[Whiteboard] Unable to read stored auth bundle", err);
        return { token: null, email: null, name: null, userId: null };
      }
    }

    function resolveIframeOrigin() {
      try {
        return new URL(iframe.src).origin;
      } catch (err) {
        try {
          return iframe.src ? new URL(iframe.src, window.location.href).origin : null;
        } catch (secondErr) {
          return null;
        }
      }
    }

    function bundleSignature(bundle) {
      if (!bundle || !bundle.token) return null;
      const userId = bundle.userId || "";
      const email = bundle.email || "";
      const name = bundle.name || "";
      return [bundle.token, userId, email, name].join("|");
    }

    function forwardTokenToSpacedeck(bundle, reason) {
      if (!iframe || !iframe.contentWindow) return;
      if (!bundle) return;
      const isForceLogout = bundle.type === "spacedeck-force-logout";
      if (!bundle.token && !isForceLogout) return;

      const signature = isForceLogout && !bundle.token ? null : bundleSignature(bundle);
      if (signature) {
        if (signature === lastSentSignature && !reason) return;
        lastSentSignature = signature;
      }

      const targetOrigin = "*";

      iframe.contentWindow.postMessage(
        {
          embedded: true,
          accessToken: bundle.token,
          email: bundle.email || undefined,
          name: bundle.name || undefined,
          type: bundle.type
        },
        targetOrigin
      );
    }

    function sendCachedBundle(reason) {
      const cached = loadStoredBundle();
      if (cached && cached.token) {
        forwardTokenToSpacedeck(cached, reason);
      }
    }

    try {
      window.addEventListener("message", function handleAuthMessage(event) {
        if (!originAllowed(event.origin)) return;

        const data = event.data;
        if (!data || typeof data !== "object") return;

        const isExpectedType =
          data.embedded === true ||
          (data.type && TOKEN_MESSAGE_TYPES.includes(data.type));

        if (!isExpectedType) return;

        const token = pickToken(data);
        if (!token && data.type !== "spacedeck-force-logout") return;

        const email =
          data.email ||
          (data.user && data.user.email) ||
          data.username ||
          data.userEmail ||
          null;

        const name =
          data.name ||
          (data.user && (data.user.name || data.user.displayName)) ||
          data.fullName ||
          data.preferred_username ||
          (email ? email.split("@")[0] : null);

        const userId = data.userId || data.user_id || null;
        const bundle = { token, email, name, userId, type: data.type };

        storeAuthBundle(bundle);
        forwardTokenToSpacedeck(bundle, "message");
      });

      iframe.addEventListener("load", function () {
        // se abbiamo già un token, forziamo logout+login solo una volta per quel token
        forceLogoutSpacedeck();
        sendCachedBundle("iframe-load");
      });

      const initialBundle = loadStoredBundle();
      if (initialBundle && initialBundle.token && iframe.contentWindow) {
        forwardTokenToSpacedeck(initialBundle, "initial");
      }
    } catch (err) {
      console.warn("[Whiteboard] Iframe modal auth init failed", err);
    }
  });
</script>

<!-- Stili base -->
<style>
  .custom-modal {
    position: fixed;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    left: 0; top: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.65);
  }

  .custom-modal-content {
    background: #fff;
    padding: 2rem;
    border-radius: 12px;
    width: min(95vw, 1440px);
    max-height: 90vh;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.5rem;
    box-shadow: 0 0 20px rgba(0,0,0,0.35);
  }

  .custom-modal-close {
    position: absolute;
    top: 16px;
    right: 20px;
    font-size: 28px;
    line-height: 1;
    color: #333;
    cursor: pointer;
    z-index: 2;
  }

  .custom-modal-close:hover {
    color: #000;
  }

  .iframe-preview-wrapper {
    flex: 1;
    width: 100%;
    min-height: 420px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background: #f8f8f8;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: stretch;
  }

  #iframePreview {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background: #fff;
  }

  @supports (aspect-ratio: 16 / 9) {
    .iframe-preview-wrapper {
      aspect-ratio: 16 / 9;
      max-height: 100%;
    }
  }

  @media (max-width: 64rem) {
    .custom-modal-content {
      width: min(98vw, 960px);
      padding: 1.5rem;
    }
  }

  @media (max-width: 40rem) {
    .custom-modal-content {
      width: 96vw;
      max-height: 85vh;
      padding: 1.25rem;
    }

    .custom-modal-close {
      top: 12px;
      right: 16px;
    }
  }
</style>
