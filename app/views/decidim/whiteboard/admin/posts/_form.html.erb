<div class="form__wrapper">
  <div class="card pt-4">
    <div class="card-section">

      <div class="row column">
        <%= post_author_select_field form, :decidim_author_id, label: t("decidim.whiteboard.actions.author_id") %>
      </div>

      <div class="row column">
        <%= form.translated :text_field, :title, autofocus: true, aria: { label: :title } %>
      </div>

      <div class="row column">
        <%= form.translated :editor, :body, lines: 30, aria: { label: :body } %>
      </div>

      <div class="row">
        <div class="columns">
          <%= form.datetime_field :published_at %>
        </div>
      </div>

      <!-- URL + pulsante modal -->
      <div class="row align-middle">
        <div class="columns small-8">
          <%= form.text_field :iframe_src, id: "iframe_src_field", label: "URL" %>
        </div>
        <div class="columns small-4 text-right">
          <button type="button" id="openIframeModal" class="button button__sm button__secondary">
            Select board 
          </button>
        </div>
      </div>

      <div class="row">
        <div class="columns">
          <%= form.text_field :iframe_width, label: t("decidim.whiteboard.admin.posts.form.iframe_width"), value: form.object.iframe_width || "100%" %>
        </div>
      </div>

      <div class="row">
        <div class="columns">
          <%= form.number_field :iframe_height, label: t("decidim.whiteboard.admin.posts.form.iframe_height"), value: form.object.iframe_height || 800 %>
        </div>
      </div>

      <!-- Modal personalizzato -->
      <div id="iframeModal" class="custom-modal" style="display: none;">
        <div class="custom-modal-content">
          <span id="closeIframeModal" class="custom-modal-close">&times;</span>
          <iframe id="iframePreview"
                  src=""
                  allowfullscreen>
          </iframe>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Script -->
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const modal = document.getElementById("iframeModal");
    const openBtn = document.getElementById("openIframeModal");
    const closeBtn = document.getElementById("closeIframeModal");
    const iframe = document.getElementById("iframePreview");
    const input = document.getElementById("iframe_src_field");
    const DEFAULT_IFRAME_URL = "https://spacedeck-dev.urbreath.tech/";
    const TOKEN_MESSAGE_TYPE = "spacedeck-token";
    const KNOWN_TOKEN_KEYS = [
      "whiteboardToken",
      "spacedeckToken",
      "token",
      "accessToken",
      "access_token",
      "keycloak",
      "kcTokens",
      "oidc.user"
    ];
    // Base information from the Decidim session, used if token decoding fails
    const DECIDIM_USER_DATA = Object.freeze(<%= raw({
      email: current_user&.email,
      name: current_user&.name,
      language: ((current_user&.locale).presence || I18n.locale).to_s,
      refreshToken: current_user&.try(:whiteboard_refresh_token)
    }.to_json) %>);

    function safeGetItem(storage, key) {
      try {
        return storage.getItem(key);
      } catch (error) {
        return null;
      }
    }

    function tryParseJSON(value) {
      if (typeof value !== "string") return value;
      const trimmed = value.trim();
      if (!trimmed) return value;
      if (trimmed.startsWith("{") || trimmed.startsWith("[")) {
        try {
          return JSON.parse(trimmed);
        } catch (error) {
          return value;
        }
      }
      return value;
    }

    function looksLikeJwt(value) {
      return typeof value === "string" && value.split(".").length === 3;
    }

    function mergeCredentials(target, source) {
      if (!source) return target;
      if (!target.accessToken && source.accessToken) target.accessToken = source.accessToken;
      if (!target.refreshToken && source.refreshToken) target.refreshToken = source.refreshToken;
      return target;
    }

    function extractTokensFromObject(data, visited = new WeakSet()) {
      if (!data || typeof data !== "object") return {};
      if (visited.has(data)) return {};
      visited.add(data);

      const credentials = {};
      const directMap = {
        accessToken: "accessToken",
        access_token: "accessToken",
        id_token: "accessToken",
        token: "accessToken",
        refreshToken: "refreshToken",
        refresh_token: "refreshToken"
      };

      Object.keys(directMap).forEach((key) => {
        if (data[key] && !credentials[directMap[key]] && typeof data[key] === "string") {
          const value = data[key];
          if (directMap[key] === "accessToken") {
            if (looksLikeJwt(value)) credentials.accessToken = value;
          } else {
            credentials.refreshToken = value;
          }
        }
      });

      if (!credentials.accessToken) {
        const possibleJwt = Object.values(data).find(
          (value) => typeof value === "string" && looksLikeJwt(value)
        );
        if (possibleJwt) credentials.accessToken = possibleJwt;
      }

      Object.values(data).forEach((value) => {
        if (credentials.accessToken && credentials.refreshToken) return;
        if (value && typeof value === "object") {
          mergeCredentials(credentials, extractTokensFromObject(value, visited));
        }
      });

      return credentials;
    }

    function extractTokensFromValue(value) {
      const parsedValue = tryParseJSON(value);

      if (typeof parsedValue === "string") {
        if (looksLikeJwt(parsedValue)) {
          return { accessToken: parsedValue };
        }
        return {};
      }

      if (Array.isArray(parsedValue)) {
        return parsedValue.reduce((accumulator, item) => mergeCredentials(
          accumulator,
          extractTokensFromValue(item)
        ), {});
      }

      if (parsedValue && typeof parsedValue === "object") {
        return extractTokensFromObject(parsedValue);
      }

      return {};
    }

    function detectCredentialsInStorage(storage) {
      if (!storage) return null;

      const credentials = {};

      KNOWN_TOKEN_KEYS.forEach((key) => {
        const value = safeGetItem(storage, key);
        mergeCredentials(credentials, extractTokensFromValue(value));
      });

      if (!credentials.accessToken || !credentials.refreshToken) {
        try {
          for (let index = 0; index < storage.length; index += 1) {
            const key = storage.key(index);
            const value = safeGetItem(storage, key);
            mergeCredentials(credentials, extractTokensFromValue(value));
            if (credentials.accessToken && credentials.refreshToken) break;
          }
        } catch (error) {
          return credentials.accessToken ? credentials : null;
        }
      }

      return credentials.accessToken || credentials.refreshToken ? credentials : null;
    }

    function getCredentialsFromBrowser() {
      const sources = [];

      try {
        if (window.localStorage) sources.push(window.localStorage);
      } catch (error) {
        // ignore access issues
      }

      try {
        if (window.sessionStorage) sources.push(window.sessionStorage);
      } catch (error) {
        // ignore access issues
      }

      for (const storage of sources) {
        const credentials = detectCredentialsInStorage(storage);
        if (credentials) return credentials;
      }

      return null;
    }

    function resolveTargetOrigin(url) {
      if (!url) return "*";

      try {
        return new URL(url).origin;
      } catch (firstError) {
        try {
          return new URL(url, window.location.href).origin;
        } catch (secondError) {
          return "*";
        }
      }
    }

    function base64UrlDecode(segment) {
      try {
        const normalized = segment.replace(/-/g, "+").replace(/_/g, "/");
        const padded = normalized.padEnd(normalized.length + ((4 - normalized.length % 4) % 4), "=");
        return atob(padded);
      } catch (error) {
        return null;
      }
    }

    function decodeTokenClaims(token) {
      if (!looksLikeJwt(token)) return {};

      try {
        const payloadSegment = token.split(".")[1];
        const decoded = base64UrlDecode(payloadSegment);
        if (!decoded) return {};
        return JSON.parse(decoded);
      } catch (error) {
        return {};
      }
    }

    function resolveEmail(claims) {
      return claims.email || claims.preferred_username || null;
    }

    function resolveName(claims) {
      if (claims.name) return claims.name;
      if (claims.given_name || claims.family_name) {
        return [claims.given_name, claims.family_name].filter(Boolean).join(" ").trim() || null;
      }
      return claims.preferred_username || claims.email || null;
    }

    function detectLanguage(claims) {
      const tokenLanguage = claims.locale || claims.lang || claims.language;
      if (tokenLanguage) return tokenLanguage;
      if (document.documentElement && document.documentElement.lang) {
        return document.documentElement.lang;
      }
      return navigator.language || navigator.userLanguage || null;
    }

    function postTokenToIframe() {
      if (!iframe || !iframe.contentWindow) return;

      const credentials = getCredentialsFromBrowser() || {};
      const accessToken = credentials.accessToken || null;
      const claims = accessToken ? decodeTokenClaims(accessToken) : {};
      const email = resolveEmail(claims) || DECIDIM_USER_DATA.email || null;
      const name = resolveName(claims) || DECIDIM_USER_DATA.name || null;
      const language = detectLanguage(claims) || DECIDIM_USER_DATA.language || null;
      const refreshToken = credentials.refreshToken || DECIDIM_USER_DATA.refreshToken || null;

      const targetOrigin = resolveTargetOrigin(iframe.src);
      const payload = {
        embedded: true,
        type: TOKEN_MESSAGE_TYPE,
        accessToken,
        refreshToken,
        email,
        name,
        language
      };

      iframe.contentWindow.postMessage(payload, targetOrigin || "*");
    }

    function handleIframeLoad() {
      postTokenToIframe();
    }

    openBtn.addEventListener("click", function() {
      const iframeUrl = input.value.trim() || DEFAULT_IFRAME_URL;

      iframe.addEventListener("load", handleIframeLoad, { once: true });
      iframe.src = iframeUrl;

      modal.style.display = "flex";
    });

    closeBtn.addEventListener("click", function() {
      modal.style.display = "none";
      iframe.src = ""; // scarica l’iframe
    });

    window.addEventListener("click", function(e) {
      if (e.target === modal) {
        modal.style.display = "none";
        iframe.src = "";
      }
    });
  });
</script>

<!-- Stili base -->
<style>
  .custom-modal {
    position: fixed;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    left: 0; top: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.65);
  }

  .custom-modal-content {
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    width: 95%;
    max-width: 1800px;
    height: 100vh;
    max-height: 100vh;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    box-shadow: 0 0 20px rgba(0,0,0,0.4);
  }

  .custom-modal-close {
    position: absolute;
    top: 8px;
    right: 16px;
    font-size: 28px;
    color: #333;
    cursor: pointer;
  }

  .custom-modal-close:hover {
    color: #000;
  }

  #iframePreview {
    flex: 1;
    width: 100%;
    max-width: 1800px;
    height: 100%;
    margin: 0 auto;
    display: block;
    border: none;
  }
</style>
