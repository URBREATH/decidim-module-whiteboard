<div class="form__wrapper">
  <div class="card pt-4">
    <div class="card-section">

      <div class="row column">
        <%= post_author_select_field form, :decidim_author_id, label: t("decidim.whiteboard.actions.author_id") %>
      </div>

      <div class="row column">
        <%= form.translated :text_field, :title, autofocus: true, aria: { label: :title } %>
      </div>

      <div class="row column">
        <%= form.translated :editor, :body, lines: 30, aria: { label: :body } %>
      </div>

      <div class="row">
        <div class="columns">
          <%= form.datetime_field :published_at %>
        </div>
      </div>

      <!-- URL + pulsante modal -->
      <div class="row align-middle">
        <div class="columns small-8">
          <%= form.text_field :iframe_src, id: "iframe_src_field", label: "URL" %>
        </div>
        <div class="columns small-4 text-right">
          <button type="button" id="openIframeModal" class="button button__sm button__secondary">
            Select board 
          </button>
        </div>
      </div>

      <div class="row">
        <div class="columns">
          <%= form.text_field :iframe_width, label: t("decidim.whiteboard.admin.posts.form.iframe_width"), value: form.object.iframe_width || "100%" %>
        </div>
      </div>

      <div class="row">
        <div class="columns">
          <%= form.number_field :iframe_height, label: t("decidim.whiteboard.admin.posts.form.iframe_height"), value: form.object.iframe_height || 800 %>
        </div>
      </div>

      <!-- Modal personalizzato -->
      <div id="iframeModal" class="custom-modal" style="display: none;">
        <div class="custom-modal-content">
          <span id="closeIframeModal" class="custom-modal-close">&times;</span>
          <iframe id="iframePreview"
                  src=""
                  allowfullscreen>
          </iframe>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Script -->
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const modal = document.getElementById("iframeModal");
    const openBtn = document.getElementById("openIframeModal");
    const closeBtn = document.getElementById("closeIframeModal");
    const iframe = document.getElementById("iframePreview");
    const input = document.getElementById("iframe_src_field");
    const DEFAULT_IFRAME_URL = "https://spacedeck-dev.urbreath.tech/";
    const TOKEN_MESSAGE_TYPE = "decidim:whiteboard:setToken";

    function safeGetItem(storage, key) {
      try {
        return storage.getItem(key);
      } catch (error) {
        return null;
      }
    }

    function detectTokenInStorage(storage) {
      if (!storage) return null;
      const knownKeys = ["whiteboardToken", "spacedeckToken", "token", "accessToken", "authToken"];

      for (const key of knownKeys) {
        const value = safeGetItem(storage, key);
        if (value) return value;
      }

      try {
        for (let index = 0; index < storage.length; index += 1) {
          const key = storage.key(index);
          if (key && key.toLowerCase().includes("token")) {
            const value = storage.getItem(key);
            if (value) return value;
          }
        }
      } catch (error) {
        return null;
      }

      return null;
    }

    function getTokenFromBrowser() {
      const sources = [];

      try {
        if (window.localStorage) sources.push(window.localStorage);
      } catch (error) {
        // ignore access issues
      }

      try {
        if (window.sessionStorage) sources.push(window.sessionStorage);
      } catch (error) {
        // ignore access issues
      }

      for (const storage of sources) {
        const token = detectTokenInStorage(storage);
        if (token) return token;
      }

      return null;
    }

    function resolveTargetOrigin(url) {
      if (!url) return "*";

      try {
        return new URL(url).origin;
      } catch (firstError) {
        try {
          return new URL(url, window.location.href).origin;
        } catch (secondError) {
          return "*";
        }
      }
    }

    function postTokenToIframe() {
      if (!iframe || !iframe.contentWindow) return;

      const token = getTokenFromBrowser();
      if (!token) return;

      const targetOrigin = resolveTargetOrigin(iframe.src);

      iframe.contentWindow.postMessage(
        { type: TOKEN_MESSAGE_TYPE, token },
        targetOrigin || "*"
      );
    }

    function handleIframeLoad() {
      postTokenToIframe();
    }

    openBtn.addEventListener("click", function() {
      const iframeUrl = input.value.trim() || DEFAULT_IFRAME_URL;

      iframe.addEventListener("load", handleIframeLoad, { once: true });
      iframe.src = iframeUrl;

      modal.style.display = "flex";
    });

    closeBtn.addEventListener("click", function() {
      modal.style.display = "none";
      iframe.src = ""; // scarica l’iframe
    });

    window.addEventListener("click", function(e) {
      if (e.target === modal) {
        modal.style.display = "none";
        iframe.src = "";
      }
    });
  });
</script>

<!-- Stili base -->
<style>
  .custom-modal {
    position: fixed;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    left: 0; top: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.65);
  }

  .custom-modal-content {
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    width: 95%;
    max-width: 1800px;
    height: 100vh;
    max-height: 100vh;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    box-shadow: 0 0 20px rgba(0,0,0,0.4);
  }

  .custom-modal-close {
    position: absolute;
    top: 8px;
    right: 16px;
    font-size: 28px;
    color: #333;
    cursor: pointer;
  }

  .custom-modal-close:hover {
    color: #000;
  }

  #iframePreview {
    flex: 1;
    width: 100%;
    max-width: 1800px;
    height: 100%;
    margin: 0 auto;
    display: block;
    border: none;
  }
</style>
