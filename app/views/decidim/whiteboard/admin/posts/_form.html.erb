<div class="form__wrapper">
  <div class="card pt-4">
    <div class="card-section">

      <div class="row column">
        <%= post_author_select_field form, :decidim_author_id, label: t("decidim.whiteboard.actions.author_id") %>
      </div>

      <div class="row column">
        <%= form.translated :text_field, :title, autofocus: true, aria: { label: :title } %>
      </div>

      <div class="row column">
        <%= form.translated :editor, :body, lines: 30, aria: { label: :body } %>
      </div>

      <div class="row">
        <div class="columns">
          <%= form.datetime_field :published_at %>
        </div>
      </div>

      <!-- URL + pulsante modal -->
      <div class="row align-middle">
        <div class="columns small-8">
          <%= form.text_field :iframe_src, id: "iframe_src_field", label: "URL" %>
        </div>
        <div class="columns small-4 text-right">
          <button type="button" id="openIframeModal" class="button button__sm button__secondary">
            Select board 
          </button>
        </div>
      </div>

      <div class="row">
        <div class="columns">
          <%= form.text_field :iframe_width, label: t("decidim.whiteboard.admin.posts.form.iframe_width"), value: form.object.iframe_width || "100%" %>
        </div>
      </div>

      <div class="row">
        <div class="columns">
          <%= form.number_field :iframe_height, label: t("decidim.whiteboard.admin.posts.form.iframe_height"), value: form.object.iframe_height || 800 %>
        </div>
      </div>

      <!-- Modal personalizzato -->
      <div id="iframeModal" class="custom-modal" style="display: none;">
        <div class="custom-modal-content">
          <span id="closeIframeModal" class="custom-modal-close">&times;</span>
          <div class="iframe-preview-wrapper">
            <iframe id="iframePreview"
                    src=""
                    allowfullscreen>
            </iframe>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Script -->
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const modal = document.getElementById("iframeModal");
    const openBtn = document.getElementById("openIframeModal");
    const closeBtn = document.getElementById("closeIframeModal");
    const iframe = document.getElementById("iframePreview");
    const input = document.getElementById("iframe_src_field");
    const DEFAULT_IFRAME_URL = "https://spacedeck-dev.urbreath.tech/";
    const TOKEN_MESSAGE_TYPES = [
      "spacedeck-token",
      "spacedeck-embedded-auth",
      "decidim:whiteboard:setToken"
    ];
    const TOKEN_KEYS = ["accessToken", "access_token", "token"];
    const STORAGE_KEYS = {
      token: "sd_session_token",
      email: "sd_session_email",
      name: "sd_session_name",
      userId: "sd_session_user_id"
    };
    const ALLOWED_PARENTS = [
      window.location.origin,
      "https://dashboard-dev.urbreath.tech",
      "https://decidim-dev.urbreath.tech",
      "https://decidim-2-dev.urbreath.tech",
      "http://localhost:3001",               
      "http://localhost:3001/testIframe.html",
      "https://community_demo.road-steamer.eu"
    ];
    const CURRENT_DECIDIM_USER = {
      id: <%= current_user&.id ? current_user.id.to_json : "null" %>,
      email: <%= current_user&.email ? current_user.email.to_json : "null" %>,
      name: <%= current_user&.name ? current_user.name.to_json : "null" %>
    };

    function openModal() {
      const iframeUrl = input.value.trim() || DEFAULT_IFRAME_URL;
      iframe.src = iframeUrl;
      modal.style.display = "flex";
    }

    function closeModal() {
      modal.style.display = "none";
      iframe.src = ""; // scarica l’iframe
    }

    openBtn.addEventListener("click", openModal);
    closeBtn.addEventListener("click", closeModal);

    window.addEventListener("click", function(event) {
      if (event.target === modal) {
        closeModal();
      }
    });

    function originAllowed(origin) {
      return ALLOWED_PARENTS.indexOf(origin) !== -1;
    }

    function pickToken(data) {
      for (const key of TOKEN_KEYS) {
        if (data && typeof data === "object" && data[key]) {
          return data[key];
        }
      }
      return null;
    }

    function withCurrentUser(bundle) {
      if (!bundle || typeof bundle !== "object") return bundle;
      const enriched = { ...bundle };
      if (CURRENT_DECIDIM_USER.email) {
        enriched.email = CURRENT_DECIDIM_USER.email;
      }
      if (CURRENT_DECIDIM_USER.name) {
        enriched.name = CURRENT_DECIDIM_USER.name;
      }
      if (CURRENT_DECIDIM_USER.id) {
        enriched.userId = String(CURRENT_DECIDIM_USER.id);
      }
      return enriched;
    }

    function persistCurrentUserProfile() {
      try {
        if (window.localStorage && CURRENT_DECIDIM_USER.id) {
          window.localStorage.setItem(STORAGE_KEYS.userId, String(CURRENT_DECIDIM_USER.id));
        }
        if (window.localStorage && CURRENT_DECIDIM_USER.email) {
          window.localStorage.setItem(STORAGE_KEYS.email, CURRENT_DECIDIM_USER.email);
        }
        if (window.localStorage && CURRENT_DECIDIM_USER.name) {
          window.localStorage.setItem(STORAGE_KEYS.name, CURRENT_DECIDIM_USER.name);
        }
      } catch (err) {
        console.warn("[Whiteboard] Unable to persist current user profile", err);
      }
    }

    function hasUserChanged(bundle) {
      const storedUserId = bundle && bundle.userId ? String(bundle.userId) : null;
      const storedEmail = bundle && bundle.email ? String(bundle.email) : null;
      const currentUserId = CURRENT_DECIDIM_USER.id ? String(CURRENT_DECIDIM_USER.id) : null;
      const currentEmail = CURRENT_DECIDIM_USER.email || null;

      if (currentUserId && storedUserId && storedUserId !== currentUserId) return true;
      if (currentEmail && storedEmail && storedEmail !== currentEmail) return true;
      return false;
    }

    function clearStoredBundle() {
      try {
        if (window.sessionStorage) {
          window.sessionStorage.removeItem(STORAGE_KEYS.token);
        }
        if (window.localStorage) {
          window.localStorage.removeItem(STORAGE_KEYS.token);
          window.localStorage.removeItem(STORAGE_KEYS.email);
          window.localStorage.removeItem(STORAGE_KEYS.name);
          window.localStorage.removeItem(STORAGE_KEYS.userId);
        }
      } catch (err) {
        console.warn("[Whiteboard] Unable to clear stored auth bundle", err);
      }
    }

    function storeAuthBundle(bundle) {
      if (!bundle || !bundle.token) return;
      const enriched = withCurrentUser(bundle);
      try {
        if (enriched.userId && window.localStorage) {
          window.localStorage.setItem(STORAGE_KEYS.userId, enriched.userId);
        }
        if ( enriched.token && window.sessionStorage ) {
          window.sessionStorage.setItem(STORAGE_KEYS.token, enriched.token);
        }
        if ( enriched.token && window.localStorage ) {
          window.localStorage.setItem(STORAGE_KEYS.token, enriched.token);
        }
        if ( enriched.email && window.localStorage ) {
          window.localStorage.setItem(STORAGE_KEYS.email, enriched.email);
        }
        if ( enriched.name && window.localStorage ) {
          window.localStorage.setItem(STORAGE_KEYS.name, enriched.name);
        }
      } catch (err) {
        console.warn("[Whiteboard] Unable to persist auth bundle", err);
      }
    }

    function loadStoredBundle() {
      try {
        const token =
          (window.sessionStorage && window.sessionStorage.getItem(STORAGE_KEYS.token)) ||
          (window.localStorage && window.localStorage.getItem(STORAGE_KEYS.token));
        const email = window.localStorage ? window.localStorage.getItem(STORAGE_KEYS.email) : null;
        const name = window.localStorage ? window.localStorage.getItem(STORAGE_KEYS.name) : null;
        const userId = window.localStorage ? window.localStorage.getItem(STORAGE_KEYS.userId) : null;
        return { token, email, name, userId };
      } catch (err) {
        console.warn("[Whiteboard] Unable to read stored auth bundle", err);
        return { token: null, email: null, name: null, userId: null };
      }
    }

    function resolveIframeOrigin() {
      try {
        return new URL(iframe.src).origin;
      } catch (err) {
        try {
          return iframe.src ? new URL(iframe.src, window.location.href).origin : null;
        } catch (secondErr) {
          return null;
        }
      }
    }

    function forwardTokenToSpacedeck(bundle) {
      if (!iframe || !iframe.contentWindow) return;
      if (!bundle || !bundle.token) return;

      const enriched = withCurrentUser(bundle);

      const targetOrigin = resolveIframeOrigin() || "*";

      iframe.contentWindow.postMessage(
        {
          embedded: true,
          accessToken: enriched.token,
          email: enriched.email || undefined,
          name: enriched.name || undefined
        },
        targetOrigin
      );
    }

    function handleAuthMessage(event) {
      if (!originAllowed(event.origin)) return;

      const data = event.data;
      if (!data || typeof data !== "object") return;

      const isExpectedType =
        data.embedded === true ||
        (data.type && TOKEN_MESSAGE_TYPES.includes(data.type));

      if (!isExpectedType) return;

      const token = pickToken(data);
      if (!token) return;

      const email =
        data.email ||
        (data.user && data.user.email) ||
        data.username ||
        data.userEmail ||
        null;

      const name =
        data.name ||
        (data.user && (data.user.name || data.user.displayName)) ||
        data.fullName ||
        data.preferred_username ||
        (email ? email.split("@")[0] : null);

      const bundle = withCurrentUser({ token, email, name });

      storeAuthBundle(bundle);
      forwardTokenToSpacedeck(bundle);
    }

    window.addEventListener("message", handleAuthMessage);

    const cachedBundle = loadStoredBundle();
    if (hasUserChanged(cachedBundle)) {
      clearStoredBundle();
    }
    persistCurrentUserProfile();

    iframe.addEventListener("load", function () {
      const bundle = withCurrentUser(loadStoredBundle());
      if (bundle && bundle.token) {
        forwardTokenToSpacedeck(bundle);
      }
    });

    const initialBundle = withCurrentUser(loadStoredBundle());
    if (initialBundle && initialBundle.token && iframe.contentWindow) {
      forwardTokenToSpacedeck(initialBundle);
    }
  });
</script>

<!-- Stili base -->
<style>
  .custom-modal {
    position: fixed;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    left: 0; top: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.65);
  }

  .custom-modal-content {
    background: #fff;
    padding: 2rem;
    border-radius: 12px;
    width: min(95vw, 1440px);
    max-height: 90vh;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.5rem;
    box-shadow: 0 0 20px rgba(0,0,0,0.35);
  }

  .custom-modal-close {
    position: absolute;
    top: 16px;
    right: 20px;
    font-size: 28px;
    line-height: 1;
    color: #333;
    cursor: pointer;
    z-index: 2;
  }

  .custom-modal-close:hover {
    color: #000;
  }

  .iframe-preview-wrapper {
    flex: 1;
    width: 100%;
    min-height: 420px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background: #f8f8f8;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: stretch;
  }

  #iframePreview {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background: #fff;
  }

  @supports (aspect-ratio: 16 / 9) {
    .iframe-preview-wrapper {
      aspect-ratio: 16 / 9;
      max-height: 100%;
    }
  }

  @media (max-width: 64rem) {
    .custom-modal-content {
      width: min(98vw, 960px);
      padding: 1.5rem;
    }
  }

  @media (max-width: 40rem) {
    .custom-modal-content {
      width: 96vw;
      max-height: 85vh;
      padding: 1.25rem;
    }

    .custom-modal-close {
      top: 12px;
      right: 16px;
    }
  }
</style>
